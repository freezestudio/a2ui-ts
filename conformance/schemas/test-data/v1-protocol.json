{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "test-data/v1-protocol.json",
  "title": "v1.0 协议测试数据",
  "type": "array",
  "items": {
    "allOf": [
      { "$ref": "common.json" },
      {
        "type": "object",
        "properties": {
          "schema": { "type": "string" },
          "data": { "type": "object" },
          "valid": { "type": "boolean" },
          "expect_error": { "type": "string" }
        },
        "required": ["data", "valid"]
      }
    ]
  }
}
