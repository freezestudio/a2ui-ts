{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "test-data/schema-validation.json",
  "title": "Schema 验证测试数据",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "description": "目标 Schema 文件名"
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "valid": { "type": "boolean", "description": "期望验证结果" },
          "data": { "type": "object", "description": "待验证数据" }
        },
        "required": ["description", "valid", "data"]
      }
    }
  },
  "required": ["schema", "tests"]
}
